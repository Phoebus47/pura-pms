generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  shifts        Shift[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  permissions String[]
  users       User[]
}

// ==================== PROPERTY ====================

model Property {
  id          String     @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?
  taxId       String?
  currency    String     @default("THB")
  timezone    String     @default("Asia/Bangkok")
  businessDate DateTime  @default(now()) @db.Date
  defaultCreditLimit Decimal? @db.Decimal(12, 2)
  roomTypes   RoomType[]
  rooms       Room[]
  rates       Rate[]
  nightAudits    NightAudit[]
  reportArchives ReportArchive[]
  shifts         Shift[]
  taxInvoices    TaxInvoice[]
  journalEntries JournalEntry[]
  arAccounts     ARAccount[]
  partnerHotels  PartnerHotel[]
  competitorRates CompetitorRate[]
  yieldRecommendations YieldRecommendation[]
  roomBlocks     RoomBlock[]
  housekeepingInspections HousekeepingInspection[]
  createdAt      DateTime   @default(now())
}

model RoomType {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  baseRate    Decimal  @db.Decimal(10, 2)
  maxAdults   Int      @default(2)
  maxChildren Int      @default(1)
  amenities   String[]
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  rooms       Room[]
  rates       Rate[]
  reservationStays ReservationStay[]
  competitorRates CompetitorRate[]
  yieldRecommendations YieldRecommendation[]
  roomBlocks RoomBlock[]
}

model Room {
  id           String             @id @default(cuid())
  number       String
  floor        Int?
  status       RoomStatus         @default(VACANT_CLEAN)
  roomTypeId   String
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  propertyId   String
  property     Property           @relation(fields: [propertyId], references: [id])
  reservations Reservation[]
  reservationStays ReservationStay[]
  hkStage      HkStage            @default(READY)
  housekeeping HousekeepingTask[]
  inspections  HousekeepingInspection[]
  movesFrom    RoomMove[]         @relation("RoomMoveFrom")
  movesTo      RoomMove[]         @relation("RoomMoveTo")
  @@unique([propertyId, number])
  @@index([propertyId, hkStage])
}

// ==================== GUESTS ====================

model Guest {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  idType       String?
  idNumber     String?
  nationality  String?
  dateOfBirth  DateTime?
  address      String?
  vipLevel     Int           @default(0)
  isBlacklist  Boolean       @default(false)
  notes        String?
  preferences  Json?
  totalStays   Int           @default(0)
  totalRevenue Decimal       @default(0) @db.Decimal(12, 2)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ==================== RESERVATIONS ====================

model Reservation {
  id             String            @id @default(cuid())
  confirmNumber  String            @unique
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  adults         Int               @default(1)
  children       Int               @default(0)
  status         ReservationStatus @default(CONFIRMED)
  source         String?
  rateCode       String?
  roomRate       Decimal           @db.Decimal(10, 2)
  totalAmount    Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  notes          String?
  specialRequest String?
  isDayUse        Boolean           @default(false)
  stayPurpose     StayPurpose       @default(STANDARD)
  approvedBy      String?
  stayPurposeNote String?
  department      String?
  billingCycle    BillingCycle      @default(NIGHTLY)
  lastInterimBillingDate DateTime?   @db.Date
  taxExempt              Boolean           @default(false)
  taxExemptReason        TaxExemptReason?
  taxExemptDocumentRef   String?
  taxExemptApprovedBy    String?
  isRoomLocked           Boolean           @default(false)
  roomLockNote           String?
  roomId          String
  room           Room              @relation(fields: [roomId], references: [id])
  guestId        String
  guest          Guest             @relation(fields: [guestId], references: [id])
  stays          ReservationStay[]
  folios         Folio[]
  fixedCharges   FixedCharge[]
  deposits       Deposit[]
  taxInvoices    TaxInvoice[]
  cardPreauths   CardPreauth[]
  roomMoves      RoomMove[]
  walks          Walk[]
  blockId        String?
  block          RoomBlock?        @relation(fields: [blockId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  @@index([checkIn, checkOut])
  @@index([status])
  @@index([isDayUse])
  @@index([stayPurpose])
  @@index([billingCycle])
  @@index([taxExempt])
  @@index([isRoomLocked])
  @@index([blockId])
}

model ReservationStay {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sequence      Int
  startDate     DateTime
  endDate       DateTime
  nights        Int
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id])
  roomTypeId    String
  roomType      RoomType    @relation(fields: [roomTypeId], references: [id])
  roomRate      Decimal     @db.Decimal(10, 2)
  rateCode      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reservationId, sequence])
  @@index([reservationId, startDate])
  @@index([roomId, startDate, endDate])
}

model RoomMove {
  id               String      @id @default(cuid())
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId], references: [id])
  fromRoomId       String
  fromRoom         Room        @relation("RoomMoveFrom", fields: [fromRoomId], references: [id])
  toRoomId         String
  toRoom           Room        @relation("RoomMoveTo", fields: [toRoomId], references: [id])
  reason           String?
  movedAt          DateTime    @default(now())
  movedBy          String
  keyCardReissued  Boolean     @default(true)
  folioTransferred Boolean     @default(true)

  @@index([reservationId, movedAt])
}

// Overbooking recovery — directory of hotels guests are walked to
model PartnerHotel {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  name          String
  address       String?
  phone         String?
  contactPerson String?
  isActive      Boolean  @default(true)
  walks         Walk[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, name])
  @@index([propertyId, isActive])
}

// Overbooking recovery — records a guest walked to a partner hotel
model Walk {
  id                 String       @id @default(cuid())
  reservationId      String
  reservation        Reservation  @relation(fields: [reservationId], references: [id])
  partnerHotelId     String
  partnerHotel       PartnerHotel @relation(fields: [partnerHotelId], references: [id])
  reason             String?
  cost               Decimal      @db.Decimal(12, 2)
  compensationAmount Decimal      @default(0) @db.Decimal(12, 2)
  compensationNotes  String?
  walkedAt           DateTime     @default(now())
  walkedBy           String

  @@index([reservationId, walkedAt])
  @@index([partnerHotelId])
}

// ==================== BILLING ====================

model Folio {
  id            String        @id @default(cuid())
  folioNumber   String        @unique
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  type          FolioType     @default(GUEST)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  creditLimit   Decimal?      @db.Decimal(12, 2)
  isClosed      Boolean       @default(false) // Deprecated: Use status instead
  isInterim     Boolean       @default(false)
  status        FolioStatus?  @default(OPEN)
  businessDate  DateTime?     @db.Date
  closedAt      DateTime?
  closedBy      String?
  transactions  Transaction[]  // Legacy: Will be replaced by FolioTransaction
  windows       FolioWindow[]
  taxInvoices   TaxInvoice[]
  invoices      Invoice[]
  arAccountId   String?
  arAccount     ARAccount?    @relation(fields: [arAccountId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([arAccountId])
}

// ==================== FINANCIAL MODULE ====================

// Transaction Code - ผังบัญชีฝั่ง PMS
model TransactionCode {
  id            String   @id @default(cuid())
  code          String   @unique // e.g., "1000" (Room Charge), "9000" (Cash)
  description   String
  descriptionTh String? // ภาษาไทย
  type          TransactionType // CHARGE, PAYMENT, ADJUSTMENT, etc.
  group         TrxGroup // ROOM, FOOD, BEVERAGE, SPA, MISC, TAX, SERVICE
  
  // Tax & Service Charge Logic
  hasTax        Boolean  @default(true)
  hasService    Boolean  @default(true)
  taxId         String?  // Link to Tax configuration
  serviceRate   Decimal? @default(10.00) @db.Decimal(5, 2) // Service Charge %
  
  // Mapping to GL (สำคัญสำหรับ Export บัญชี)
  glAccountCode String   // e.g., "4000-01" (Revenue-Room)
  departmentCode String? // สำหรับ USALI
  
  transactions      FolioTransaction[]
  fixedCharges      FixedCharge[]
  packageSplitRules PackageSplitRule[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Package split at posting time (rateCode → USALI trx codes). Percents are 0–100.
model PackageSplitRule {
  id        String          @id @default(cuid())
  rateCode  String
  trxCodeId String
  trxCode   TransactionCode @relation(fields: [trxCodeId], references: [id], onDelete: Restrict)
  percent   Decimal         @db.Decimal(5, 2)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([rateCode, isActive])
}

// Folio Window - การแยกบิล
model FolioWindow {
  id           String             @id @default(cuid())
  folioId      String
  folio        Folio              @relation(fields: [folioId], references: [id], onDelete: Cascade)
  windowNumber Int                // 1, 2, 3, 4
  description  String?            // e.g. "Personal Expenses", "Company Charges"
  balance      Decimal            @default(0.00) @db.Decimal(12, 2)
  transactions FolioTransaction[]
  createdAt    DateTime           @default(now())
  @@unique([folioId, windowNumber])
}

// Folio Transaction - Enhanced (replaces Transaction model)
model FolioTransaction {
  id            String   @id @default(cuid())
  windowId      String
  window        FolioWindow @relation(fields: [windowId], references: [id])
  trxCodeId     String
  trxCode       TransactionCode @relation(fields: [trxCodeId], references: [id])
  
  // Dates are Critical
  businessDate  DateTime @db.Date // วันที่ทางบัญชีโรงแรม
  createdAt     DateTime @default(now()) // วันที่บันทึกจริง (System timestamp)
  
  // Money (ต้องเก็บละเอียด แยก Vat/Service)
  amountNet     Decimal  @db.Decimal(12, 2) // ราคาก่อนภาษี/Service
  amountService Decimal  @default(0) @db.Decimal(12, 2) // Service Charge 10%
  amountTax     Decimal  @default(0) @db.Decimal(12, 2) // VAT 7%
  amountTotal   Decimal  @db.Decimal(12, 2) // Net + Svc + Tax
  
  // Sign (Charge = +, Payment = -)
  sign          Int      // 1 or -1
  
  // Reference & Audit
  reference     String?  // e.g., "Room 101", "Check #1234", "POS-001"
  remark        String?
  userId        String   // ใครเป็นคนทำรายการ
  shiftId       String?  // ทำในกะไหน
  shift         Shift?   @relation(fields: [shiftId], references: [id])
  nightAuditId  String?  // ถูกปิดรอบไปหรือยัง (ถ้ามีค่า = ห้ามแตะต้องแล้ว)
  
  // Reason Code (บังคับสำหรับ Void/Adjustment)
  reasonCodeId  String?
  reasonCode    ReasonCode? @relation(fields: [reasonCodeId], references: [id])
  
  // Correction linkage
  relatedTrxId  String?  // ถ้าเป็นการ Void, Link กลับไปที่รายการเดิม
  isVoid        Boolean  @default(false)
  voidedAt      DateTime?
  voidedBy      String?
  
  // Indexes for performance
  @@index([businessDate])
  @@index([windowId, businessDate])
  @@index([nightAuditId])
  @@index([trxCodeId])
  @@index([userId])
  @@index([isVoid])
  @@index([relatedTrxId])
  @@index([shiftId])
}

// Reason Code
model ReasonCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  descriptionTh String?
  category    ReasonCategory
  isActive    Boolean  @default(true)
  transactions FolioTransaction[]
  createdAt   DateTime @default(now())
}

// Routing Instructions - การโยนบิลอัตโนมัติ
model RoutingInstruction {
  id            String   @id @default(cuid())
  sourceFolioId String
  targetFolioId String
  targetWindow  Int
  
  trxCodes      String[] // Array of TrxCodes to route (e.g. ["1000", "2000"])
  dateFrom      DateTime @db.Date
  dateTo        DateTime @db.Date
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Deposit Ledger
model Deposit {
  id            String   @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("THB")
  exchangeRate Decimal? @db.Decimal(10, 4) // ถ้าจ่ายด้วยสกุลอื่น
  method        PaymentMethod
  receivedAt    DateTime @default(now())
  receivedBy    String
  reference     String?
  notes         String?
  // เมื่อ Check-in จะโอนไปเป็น Payment ใน Folio
  transferredToFolio Boolean @default(false)
  transferredAt      DateTime?
}

// Currency Exchange
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @default("THB")
  targetCurrency String
  rate          Decimal  @db.Decimal(10, 4)
  effectiveDate DateTime @db.Date
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  @@unique([baseCurrency, targetCurrency, effectiveDate])
}

// Tax Invoice — internal running number. RD e-Tax API is out of scope.
model TaxInvoice {
  id            String         @id @default(cuid())
  invoiceNumber String
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folioId       String?
  folio         Folio?         @relation(fields: [folioId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation?   @relation(fields: [reservationId], references: [id])
  businessDate  DateTime       @db.Date

  taxId         String
  branchNumber  String?
  buyerName     String?

  amountNet     Decimal        @db.Decimal(12, 2)
  amountTax     Decimal        @db.Decimal(12, 2)
  amountTotal   Decimal        @db.Decimal(12, 2)

  eTaxInvoiceId String?
  qrCode        String?

  status        InvoiceStatus  @default(OPEN)
  issuedAt      DateTime?
  issuedBy      String?
  voidReason    String?
  voidedAt      DateTime?
  voidedBy      String?
  createdAt     DateTime       @default(now())

  @@unique([propertyId, invoiceNumber])
  @@index([propertyId, businessDate])
  @@index([folioId])
}

// Fixed Charges (Recurring)
model FixedCharge {
  id            String   @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  trxCodeId     String
  trxCode       TransactionCode @relation(fields: [trxCodeId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  description   String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  isActive      Boolean  @default(true)
  posted        Boolean  @default(false) // ถูก Post แล้วหรือยัง
  createdAt     DateTime @default(now())
}

// Legacy Transaction model (deprecated - will be removed after migration)
model Transaction {
  id          String          @id @default(cuid())
  folioId     String
  folio       Folio           @relation(fields: [folioId], references: [id])
  type        TransactionType
  category    String
  description String
  amount      Decimal         @db.Decimal(12, 2)
  tax         Decimal         @default(0) @db.Decimal(10, 2)
  shiftId     String?
  shift       Shift?          @relation(fields: [shiftId], references: [id])
  postedBy    String
  postedAt    DateTime        @default(now())
  isVoid      Boolean         @default(false)
  voidReason  String?
  voidedAt    DateTime?
}

model Payment {
  id         String        @id @default(cuid())
  folioId    String
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  cardLast4  String?
  shiftId    String?
  receivedBy String
  receivedAt DateTime      @default(now())
}

// ==================== SHIFT MANAGEMENT ====================

model Shift {
  id                  String      @id @default(cuid())
  shiftNumber         String      @unique
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  propertyId          String
  property            Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  businessDate        DateTime    @db.Date
  startTime           DateTime
  endTime             DateTime?
  openingCash         Decimal     @db.Decimal(12, 2)
  closingCash         Decimal?    @db.Decimal(12, 2)
  expectedCash        Decimal?    @db.Decimal(12, 2)
  cashVariance        Decimal?    @db.Decimal(12, 2)
  status              ShiftStatus @default(OPEN)
  closedBy            String?
  managerApprovedBy   String?
  managerApprovedAt   DateTime?
  varianceReason      String?
  handoverToUserId    String?
  handoverFromShiftId String?
  notes               String?
  transactions        Transaction[] // Legacy: Will be removed after migration
  folioTransactions   FolioTransaction[]

  @@index([propertyId, businessDate, status])
  @@index([userId, status])
}

// ==================== NIGHT AUDIT ====================

model NightAudit {
  id            String          @id @default(cuid())
  propertyId    String
  property      Property        @relation(fields: [propertyId], references: [id])
  businessDate  DateTime        @db.Date
  status        AuditStatus     @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?
  performedBy   String?
  roomsPosted   Int             @default(0)
  revenuePosted Decimal         @default(0) @db.Decimal(12, 2)
  discrepancies Json?
  notes         String?
  reports       ReportArchive[]
  errors        AuditError[]
  @@unique([propertyId, businessDate])
}

model AuditError {
  id           String     @id @default(cuid())
  nightAuditId String
  nightAudit   NightAudit @relation(fields: [nightAuditId], references: [id])
  errorType    String
  description  String
  resolved     Boolean    @default(false)
  resolvedBy   String?
  resolvedAt   DateTime?
}

// ==================== REPORT ARCHIVE ====================

model ReportArchive {
  id           String      @id @default(cuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id])
  reportType   String
  reportName   String
  businessDate DateTime    @db.Date
  parameters   Json?
  data         Json
  summary      Json?
  pdfPath      String?
  excelPath    String?
  nightAuditId String?
  nightAudit   NightAudit? @relation(fields: [nightAuditId], references: [id])
  generatedBy  String
  generatedAt  DateTime    @default(now())
  @@index([propertyId])
  @@index([reportType, businessDate])
  @@index([businessDate])
}

// ==================== FINANCIAL ====================

model GLAccount {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  type     AccountType
  parentCode String?
  isActive Boolean       @default(true)
  balance  Decimal       @default(0) @db.Decimal(14, 2)
  entries  JournalLine[]
}

model JournalEntry {
  id          String        @id @default(cuid())
  entryNumber String        @unique
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  entryDate   DateTime      @db.Date
  reference   String?
  description String
  source      String
  lines       JournalLine[]
  isPosted    Boolean       @default(false)
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime      @default(now())

  @@unique([propertyId, entryDate, source])
  @@index([propertyId, entryDate])
}

model JournalLine {
  id          String       @id @default(cuid())
  journalId   String
  journal     JournalEntry @relation(fields: [journalId], references: [id])
  accountId   String
  account     GLAccount    @relation(fields: [accountId], references: [id])
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  credit      Decimal      @default(0) @db.Decimal(14, 2)
  description String?
}

model ARAccount {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  accountNumber  String
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  creditLimit    Decimal   @db.Decimal(14, 2)
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  paymentTerms   Int       @default(30)
  isActive       Boolean   @default(true)
  invoices       Invoice[]
  folios         Folio[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([propertyId, accountNumber])
  @@index([propertyId, isActive])
}

model Invoice {
  id            String           @id @default(cuid())
  invoiceNumber String
  propertyId    String
  arAccountId   String
  arAccount     ARAccount        @relation(fields: [arAccountId], references: [id])
  folioId       String?
  folio         Folio?           @relation(fields: [folioId], references: [id])
  invoiceDate   DateTime         @db.Date
  dueDate       DateTime         @db.Date
  amount        Decimal          @db.Decimal(14, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(14, 2)
  status        InvoiceStatus    @default(OPEN)
  payments      InvoicePayment[]
  createdAt     DateTime         @default(now())

  @@unique([propertyId, invoiceNumber])
  @@index([propertyId, invoiceDate])
  @@index([arAccountId, status])
  @@index([folioId])
}

model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  amount       Decimal  @db.Decimal(14, 2)
  method       String
  reference    String?
  paidBy       String
  businessDate DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

model CardPreauth {
  id                 String            @id @default(cuid())
  reservationId      String
  reservation        Reservation       @relation(fields: [reservationId], references: [id])
  amount             Decimal           @db.Decimal(12, 2)
  status             CardPreauthStatus @default(HELD)
  last4              String
  expiryMonth        Int
  expiryYear         Int
  manualRef          String
  capturedAmount     Decimal?          @db.Decimal(12, 2)
  folioId            String?
  folioTransactionId String?
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([reservationId, status])
}

// ==================== HOUSEKEEPING ====================

model HousekeepingTask {
  id          String     @id @default(cuid())
  roomId      String
  room        Room       @relation(fields: [roomId], references: [id])
  taskType    String
  priority    Int        @default(1)
  assignedTo  String?
  status      TaskStatus @default(PENDING)
  notes       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
}

enum HkStage {
  DIRTY
  CLEAN
  READY
}

enum InspectionResult {
  PASSED
  FAILED
}

model HousekeepingInspection {
  id           String                         @id @default(cuid())
  propertyId   String
  property     Property                       @relation(fields: [propertyId], references: [id])
  roomId       String
  room         Room                           @relation(fields: [roomId], references: [id])
  businessDate DateTime                       @db.Date
  result       InspectionResult
  inspectedBy  String
  notes        String?
  lines        HousekeepingInspectionLine[]
  createdAt    DateTime                       @default(now())

  @@index([propertyId, businessDate])
  @@index([roomId, createdAt])
}

model HousekeepingInspectionLine {
  id            String                   @id @default(cuid())
  inspectionId  String
  inspection    HousekeepingInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemCode      String
  passed        Boolean
  notes         String?

  @@index([inspectionId])
}

// ==================== RATES ====================

enum RateDeriveMode {
  PERCENT_OFFSET
  AMOUNT_OFFSET
}

model Rate {
  id           String          @id @default(cuid())
  code         String
  name         String
  roomTypeId   String
  roomType     RoomType        @relation(fields: [roomTypeId], references: [id])
  propertyId   String
  property     Property        @relation(fields: [propertyId], references: [id])
  amount       Decimal         @db.Decimal(10, 2)
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  daysOfWeek   Int[]
  isActive     Boolean         @default(true)
  parentRateId String?
  parentRate   Rate?           @relation("RateDerivation", fields: [parentRateId], references: [id], onDelete: Restrict)
  childRates   Rate[]          @relation("RateDerivation")
  deriveMode   RateDeriveMode?
  deriveValue  Decimal?        @db.Decimal(10, 4)
  yieldRecommendations YieldRecommendation[]
  @@index([roomTypeId, startDate, endDate])
  @@index([parentRateId])
  @@index([propertyId, code])
}

enum YieldRecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum YieldRecommendReason {
  HIGH_DEMAND
  SLOW_PACE
  COMP_UNDERCUT
}

model CompetitorRate {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])
  competitorName  String
  roomTypeId      String?
  roomType        RoomType? @relation(fields: [roomTypeId], references: [id])
  stayDate        DateTime  @db.Date
  amount          Decimal   @db.Decimal(10, 2)
  notes           String?
  capturedAt      DateTime  @default(now())

  @@index([propertyId, stayDate])
  @@index([roomTypeId, stayDate])
}

model YieldRecommendation {
  id                 String                     @id @default(cuid())
  propertyId         String
  property           Property                   @relation(fields: [propertyId], references: [id])
  roomTypeId         String
  roomType           RoomType                   @relation(fields: [roomTypeId], references: [id])
  rateId             String
  rate               Rate                       @relation(fields: [rateId], references: [id])
  stayDate           DateTime                   @db.Date
  currentAmount      Decimal                    @db.Decimal(10, 2)
  recommendedAmount  Decimal                    @db.Decimal(10, 2)
  occupancyPct       Decimal                    @db.Decimal(5, 2)
  paceDeltaPct       Decimal?                   @db.Decimal(6, 2)
  competitorAmount   Decimal?                   @db.Decimal(10, 2)
  reason             YieldRecommendReason
  status             YieldRecommendationStatus  @default(PENDING)
  appliedAt          DateTime?
  createdAt          DateTime                   @default(now())

  @@index([propertyId, status])
  @@index([propertyId, stayDate])
  @@index([rateId, stayDate])
}

enum BlockKind {
  ALLOTMENT
  GROUP
}

enum BlockInventoryMode {
  GENERAL
  DEDICATED
}

enum BlockStatus {
  OPEN
  RELEASED
  CLOSED
}

model RoomBlock {
  id             String             @id @default(cuid())
  propertyId     String
  property       Property           @relation(fields: [propertyId], references: [id])
  roomTypeId     String
  roomType       RoomType           @relation(fields: [roomTypeId], references: [id])
  code           String
  name           String
  kind           BlockKind
  inventoryMode  BlockInventoryMode @default(GENERAL)
  channel        String?
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  cutoffDate     DateTime           @db.Date
  allottedRooms  Int
  releasedRooms  Int                @default(0)
  status         BlockStatus        @default(OPEN)
  notes          String?
  reservations   Reservation[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([propertyId, code])
  @@index([propertyId, status])
  @@index([propertyId, startDate, endDate])
  @@index([cutoffDate, status])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([userId, timestamp])
}


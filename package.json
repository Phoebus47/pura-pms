{
  "name": "pura",
  "version": "1.0.0",
  "private": true,
  "description": "PURA Property Management System",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "lint:fix": "turbo lint",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "db:push": "pnpm --filter database db:push",
    "db:generate": "pnpm --filter database db:generate",
    "sonar": "pnpm test:coverage && npx dotenv-cli -- npx sonarqube-scanner",
    "prepare": "husky || true",
    "test": "turbo test",
    "test:coverage": "turbo test:cov",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "turbo": "^2.9.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "next": "16.2.12",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion@^5.0.0": "5.0.9",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "multer": "2.2.0",
      "undici": "7.29.0",
      "form-data": "4.0.6",
      "vite": "7.3.6",
      "fast-uri": "3.1.5",
      "postcss": ">=8.5.18",
      "defu": ">=6.1.5",
      "js-yaml": "4.3.1",
      "nanoid@^3.0.0": "3.3.18",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.5",
      "path-to-regexp@^8.0.0": "8.4.2",
      "path-to-regexp@~0.1.0": "0.1.13",
      "effect": "3.20.0",
      "sharp": "0.35.3",
      "yaml": "2.8.4",
      "serialize-javascript": ">=7.0.5",
      "flatted": ">=3.4.0",
      "file-type": ">=21.3.2",
      "qs": "6.15.3",
      "uuid@^11.0.0": "11.1.1",
      "body-parser": "2.3.0",
      "@babel/core": "7.29.7",
      "@opentelemetry/core": ">=2.8.0",
      "ajv": ">=8.18.0",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0"
    }
  }
}
